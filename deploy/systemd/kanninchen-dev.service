# Purpose: systemd unit for Kaninchen Quest DEV.

[Unit]
Description=Kaninchen Quest DEV Next.js Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webapps
Group=webapps
WorkingDirectory=/opt/sites/kanninchen.dev/app
EnvironmentFile=/etc/kanninchen.dev/kanninchen.env
Environment=NODE_ENV=production
Environment=PORT=3004
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3004
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/sites/kanninchen.dev/app/.next /opt/logs/kanninchen.dev

[Install]
WantedBy=multi-user.target
